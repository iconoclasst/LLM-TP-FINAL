# Variáveis opcionais do reproduce.py. Copie para .env (ignorado pelo Git) e carregue com:
#   set -a; source .env; set +a
# Nenhuma é obrigatória: modelos e dados são públicos.

# Cache do Hugging Face (padrão: artifacts/hf dentro do repositório)
# HF_HOME=/caminho/para/hf_cache

# Token do Hugging Face: opcional, só acelera downloads. Nunca o coloque no repositório.
# HF_TOKEN=

# Endereço do Ollama usado pelo juiz do Gustavo (padrão: http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434

# llama-server e GGUF próprios para o juiz do Rubens/Kayque (padrão: baixados pelo controlador)
# LLAMA_SERVER=/caminho/llama-server
# JUDGE_GGUF=/caminho/Qwen3-8B-Q4_K_M.gguf

# Onde ficam insumos, saídas e ambientes (por exemplo, em outro disco)
# REPRO_ARTIFACTS=/outro/disco/artifacts
# REPRO_OUTPUTS=/outro/disco/outputs
# REPRO_ENVS=/outro/disco/envs
